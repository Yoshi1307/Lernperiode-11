<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VociTrainer.ViewModels"
        xmlns:models="using:VociTrainer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="VociTrainer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VociTrainer">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl>
        <TabItem Header="Start">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="VociTrainer" FontSize="20" FontWeight="Bold" />
                </StackPanel>
        </TabItem>

        <TabItem Header="Wortliste">
            <ListBox Margin="20" ItemsSource="{Binding Words}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:Word">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding German}" FontWeight="Bold" Width="100" />
                            <TextBlock Text="=" />
                            <TextBlock Text="{Binding English}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </TabItem>

        <TabItem Header="Abfrage">
            <StackPanel Margin="20" Spacing="15">
                <TextBlock Text="Wie heisst dieses Wort auf Englisch?" />
                <TextBlock Text="{Binding CurrentWord.German}" FontSize="24" FontWeight="Bold" />
                <TextBox Text="{Binding UserAnswer}" Watermark="Deine Antwort" />
                <Button Content="Prüfen" Command="{Binding CheckAnswerCommand}" />
                <TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>
    </TabControl>

</Window>