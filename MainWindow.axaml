<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VociTrainer.ViewModels"
        xmlns:models="using:VociTrainer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="VociTrainer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="VociTrainer">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl>
        <TabItem Header="Start">
            <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="VociTrainer" FontSize="20" FontWeight="Bold" />
                </StackPanel>
        </TabItem>

       <TabItem Header="Wortliste">
            <ScrollViewer>
                <StackPanel Margin="20" Spacing="10">
                    <TextBlock Text="Englisch Wörter" FontSize="20" FontWeight="Bold" />

                    <ListBox ItemsSource="{Binding WordsE}"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Word">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding GermanE}" FontWeight="Bold" Width="100" />
                                    <TextBlock Text="=" />
                                    <TextBlock Text="{Binding English}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Französisch Wörter" FontSize="20" FontWeight="Bold" />
                     <ListBox ItemsSource="{Binding WordsF}"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Word">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding GermanF}" FontWeight="Bold" Width="100" />
                                    <TextBlock Text="=" />
                                    <TextBlock Text="{Binding French}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>



    <TabItem Header="Abfrage">
        <StackPanel Margin="20" Spacing="15">
            <ComboBox x:Name="LanguageCombo" SelectedIndex="0" HorizontalAlignment="Left">
        <ComboBoxItem Content="Englisch" />
        <ComboBoxItem Content="Französisch" />
    </ComboBox>
    <TextBlock x:CompileBindings="False"
           Text="{Binding #LanguageCombo.SelectedItem.Content, StringFormat='Wie heisst dieses Wort auf {0}?'}" />
                <TextBlock Text="{Binding CurrentWord.GermanE}" FontSize="24" FontWeight="Bold" />
                <TextBox Text="{Binding UserAnswer}" Watermark="Deine Antwort" />
            <Button Content="Prüfen" Command="{Binding CheckAnswerCommand}" />
            <TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap" />
        </StackPanel>
    </TabItem>
    </TabControl>

</Window>